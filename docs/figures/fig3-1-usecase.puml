@startuml fig3-1-usecase
' ===== 统一黑白打印样式：白底 / 黑框 / 黑字 / 无阴影 =====
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 13
skinparam dpi 150
skinparam defaultFontColor #000000
skinparam ArrowColor #000000
skinparam ArrowFontColor #000000
skinparam linetype ortho
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
' 16 个用例单列纵向排列，按参与者分组：
' 匿名用户 → 登录用户 → 群组成员 → 群组管理员 / 所有者；4 个参与者统一置于左侧。
' 隐藏连线固定用例的单列纵向次序，并使参与者之间保持上下次序；
' 同一参与者的用例在列中相邻，因此其连线呈互不交叉的扇形。
top to bottom direction

actor "匿名用户" as anon
actor "登录用户" as user
actor "群组成员" as member
actor "群组管理员\n/所有者" as admin

rectangle "智能音视频实时通讯平台" {
  ' —— 匿名用户 ——
  usecase "注册与邮箱验证" as UC1
  usecase "登录与两步验证" as UC2
  ' —— 登录用户 ——
  usecase "维护个人资料\n与在线状态" as UC3
  usecase "好友管理" as UC4
  usecase "私信沟通" as UC5
  usecase "创建 / 加入群组" as UC6
  usecase "通过邀请链接加入群组" as UC16
  ' —— 群组成员 ——
  usecase "收发频道消息" as UC7
  usecase "消息回应 / 置顶 / 搜索" as UC8
  usecase "上传附件" as UC9
  ' —— 登录用户与群组成员共有 ——
  usecase "语音频道通话" as UC10
  usecase "音视频通话\n（摄像头/屏幕共享）" as UC15
  ' —— 群组管理员 / 所有者 ——
  usecase "管理群组与频道" as UC11
  usecase "角色与权限覆盖管理" as UC12
  usecase "成员踢出 / 封禁" as UC13
  usecase "查看审计日志" as UC14
}

anon --> UC1
anon --> UC2
user --> UC3
user --> UC4
user --> UC5
user --> UC6
user --> UC16
user --> UC10
user --> UC15
member --> UC7
member --> UC8
member --> UC9
member --> UC10
member --> UC15
admin --> UC11
admin --> UC12
admin --> UC13
admin --> UC14

' 隐藏连线：用例单列纵向次序
UC1 -[hidden]-> UC2
UC2 -[hidden]-> UC3
UC3 -[hidden]-> UC4
UC4 -[hidden]-> UC5
UC5 -[hidden]-> UC6
UC6 -[hidden]-> UC16
UC16 -[hidden]-> UC7
UC7 -[hidden]-> UC8
UC8 -[hidden]-> UC9
UC9 -[hidden]-> UC10
UC10 -[hidden]-> UC15
UC15 -[hidden]-> UC11
UC11 -[hidden]-> UC12
UC12 -[hidden]-> UC13
UC13 -[hidden]-> UC14
' 隐藏连线：参与者自上而下的次序（群组管理员 → 群组成员 → 登录用户 → 匿名用户）
admin -[hidden]-> member
member -[hidden]-> user
user -[hidden]-> anon
@enduml
