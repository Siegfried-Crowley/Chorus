@startuml fig4-2-er
' 引擎说明：本图用 Graphviz(dot) 正交布线（对比后优于内置 Smetana 的斜线布局）
' ===== 统一黑白打印样式：白底 / 黑框 / 黑字 / 无阴影 =====
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 13
skinparam dpi 150
skinparam defaultFontColor #000000
skinparam ArrowColor #000000
skinparam ArrowFontColor #000000
skinparam linetype ortho
skinparam nodesep 22
skinparam ranksep 60
skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
  HeaderBackgroundColor #FFFFFF
}
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
  AttributeFontColor #000000
  StereotypeFontColor #000000
}
' 三层布局（自左向右为层级推进方向，自下而上为依赖深度）：
'   第一层 用户 / 群组域（users、guilds 及其直接下游）
'   第二层 频道 / 消息域（channels、messages、覆盖与成员角色）
'   第三层 语音与附属表（voice_*、invites、bans、audit_log、共享主键类）
' 只保留真实外键关系；实体按依赖顺序声明，使连线就近连接、避免长距离跨越。
left to right direction

' ================= 第一层：用户 / 群组域 =================
entity "users 用户" as users {
  * id
  --
  邮箱 / 密码哈希
  用户名 / 头像 / 2FA
}
entity "guilds 群组" as guilds {
  * id
  --
  名称 / 图标
  owner_id → users
}
entity "relationships 好友关系" as relationships {
  * 用户 + 对方
  --
  状态 (好友/待接受/已屏蔽)
}
entity "dm_channels 私信频道" as dm_channels {
  * id
  --
  last_message_id
}

' ================= 第二层：频道 / 消息域 =================
entity "channels 频道" as channels {
  * id
  --
  名称 / type(4=分类)
  position / parent_id
}
entity "guild_members 群组成员" as guild_members {
  * 群组 + 用户
  --
  昵称 / 加入时间
}
entity "messages 消息" as messages {
  * channel_id + id
  --
  author_id → users
  内容 / 附件
}
entity "channel_overwrites\n频道权限覆盖" as channel_overwrites {
  * 频道 + 目标
  --
  type (0 角色 / 1 成员)
  allow / deny 位
}
entity "roles 角色" as roles {
  * id
  --
  名称 / 颜色
  permissions (64 位掩码)
  position
}
entity "member_roles 成员角色" as member_roles {
  * 群组 + 用户 + 角色
}

' ================= 第三层：语音与附属表 =================
entity "voice_states 语音状态" as voice_states {
  * 群组 + 用户
  --
  channel_id / session_id
  self_mute / self_deaf
}
entity "invites 邀请" as invites {
  * code
  --
  过期时间 / 次数限制
}
entity "bans 封禁" as bans {
  * 群组 + 用户
  --
  原因
}
entity "audit_log 审计日志" as audit_log {
  * id
  --
  动作 / 详情 JSON
}
entity "voice_servers 语音服务器" as voice_servers {
  * id
  --
  ip / port / region
}
entity "voice_allocations\n语音分配令牌" as voice_allocations {
  * id
  --
  群组 + 用户 (唯一)
  token / channel_id
  expires_at (30s)
}
class "dm_channel_members\n私信成员" as dm_channel_members {
  * 频道 + 用户
}
class "MessageId\n<<IdClass 共享主键>>" as MessageId {
  channel_id : Long
  id : Long
}
class "GuildBanId\n<<IdClass 共享主键>>" as GuildBanId {
  guild_id : Long
  user_id : Long
}

' ================= 真实外键关系 =================
users ||--o{ relationships : 发起
users ||--o{ dm_channels : 参与
dm_channels ||--o{ dm_channel_members : 包含
users ||--o{ guilds : owner
guilds ||--o{ guild_members : 拥有
users ||--o{ guild_members : 加入
guilds ||--o{ roles : 定义
guilds ||--o{ channels : 包含
roles ||--o{ member_roles : 指派
guild_members ||--o{ member_roles : 持有
channels ||--o{ messages : 承载
channels ||--o{ channel_overwrites : 覆盖
channels ||--o{ voice_states : 语音
guilds ||--o{ invites : 签发
guilds ||--o{ bans : 记录
guilds ||--o{ audit_log : 记录
voice_servers ||--o{ voice_allocations : 分配
users ||--o{ voice_allocations : 获得
messages *-- MessageId : 复合主键
bans *-- GuildBanId : 复合主键
@enduml
